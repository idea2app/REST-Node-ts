{
    "name": "@idea2app/rest-node-ts",
    "version": "1.3.0",
    "license": "LGPL-3.0",
    "author": "shiy2008@gmail.com",
    "description": "RESTful API service scaffold based on Node.js & TypeScript",
    "homepage": "https://github.com/idea2app/REST-Node-ts#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/idea2app/REST-Node-ts.git"
    },
    "bugs": {
        "url": "https://github.com/idea2app/REST-Node-ts/issues"
    },
    "source": "source/index.ts",
    "main": "dist/index.js",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1130.0",
        "@aws-sdk/s3-request-presigner": "^3.1130.0",
        "@koa/cors": "^5.0.0",
        "@koa/multer": "^4.0.0",
        "@koa/router": "^15.7.0",
        "@passwordless-id/webauthn": "^2.4.0",
        "@smithy/core": "^3.33.3",
        "@supabase/auth-js": "^2.116.0",
        "@supabase/supabase-js": "^2.116.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "jsonwebtoken": "^9.0.3",
        "koa": "^3.2.0",
        "koa-bodyparser": "^4.4.1",
        "koa-jwt": "^4.0.4",
        "koa-logger": "^4.0.0",
        "koa-mount": "^4.2.0",
        "koa2-swagger-ui": "^5.12.0",
        "koagger": "^0.4.0",
        "marked": "^18.0.12",
        "mobx": "^7.0.3",
        "mobx-github": "^0.7.1",
        "mobx-restful": "^2.1.5",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "routing-controllers": "^0.11.3",
        "routing-controllers-openapi": "^5.0.1",
        "tslib": "^2.8.1",
        "typeorm": "^1.1.1",
        "undici": "^8.10.2",
        "web-utility": "^4.7.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@octokit/openapi-types": "^29.0.1",
        "@swc/core": "^1.16.2",
        "@swc/helpers": "^0.5.23",
        "@types/eslint-config-prettier": "^6.11.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/koa": "^3.0.3",
        "@types/koa-logger": "^3.1.5",
        "@types/node": "^24.13.4",
        "better-sqlite3": "^13.0.3",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "expect": "^30.5.1",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "koajax": "^3.3.1",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.6",
        "start-server-and-test": "^3.0.12",
        "swagger-typescript-api": "^13.12.6",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0"
    },
    "resolutions": {
        "reflect-metadata": "$reflect-metadata",
        "koa": "$koa"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "tabWidth": 4,
        "printWidth": 100
    },
    "lint-staged": {
        "*.{md,json,yml,ts}": "prettier --write",
        "*.ts": "eslint --fix"
    },
    "ts-node": {
        "swc": true
    },
    "scripts": {
        "install": "cp -u .env.example .env  ||  true",
        "prepare": "husky || true",
        "dev": "node -r ts-node/register --watch source/",
        "lint": "lint-staged",
        "build-test": "swagger-typescript-api generate -p http://localhost:8080/docs/spec -o test/ -n client.ts",
        "start-test": "rm -rf .data/  &&  node dist/",
        "test-cases": "cross-env TS_NODE_PROJECT=test/tsconfig.json  node -r ts-node/register --test test/**/*.test.ts",
        "debug": "server-test start-test 8080 test-cases",
        "test": "npm run build  &&  server-test start-test 8080 build-test  &&  npm run debug",
        "pack-type": "tsc --emitDeclarationOnly --outDir type/  &&  cd type/  &&  rm -f *.d.ts  &&  cp -rf model/* .  &&  rm -rf model/ service/ controller/",
        "build": "rm -rf dist/ type/*.d.ts  &&  tsc  &&  npm run pack-type",
        "start": "cross-env NODE_ENV=production  node dist/",
        "typeorm": "typeorm-ts-node-commonjs -d source/model/index.ts",
        "migration:generate": "npm run typeorm -- migration:generate",
        "migration:run": "npm run typeorm -- migration:run",
        "upgrade:dev": "npm run migration:generate -- migration/version  &&  npm run migration:run",
        "upgrade:pro": "cross-env NODE_ENV=production  npm run migration:generate -- .data/version  &&  npm run migration:run",
        "pack-image": "docker build -t idea2app/rest-node-ts:latest .",
        "container": "docker rm -f rest-node-ts  &&  docker run --name rest-node-ts -p 8080:8080 -d idea2app/rest-node-ts:latest"
    }
}
